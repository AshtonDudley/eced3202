TEXT -568 576 Left 2 !* ---- Q1 2N3906 (PNP): E=e1, B=b1, C=c1 ----\n.meas TRAN Q1_Icpk  MAX abs(Ic(Q1))\n.meas TRAN Q1_Vecpk MAX V(e1,c1)\n.meas TRAN Q1_Pavg  AVG Ic(Q1)*V(c1,e1)+Ib(Q1)*V(b1,e1) FROM 40m TO 50m\n.meas TRAN Q1_Ppk   MAX Ic(Q1)*V(c1,e1)+Ib(Q1)*V(b1,e1)\n* ---- Q2 2N2222 (NPN): C=VCC, B=c1, E=e2 ----\n.meas TRAN Q2_Icpk  MAX abs(Ic(Q2))\n.meas TRAN Q2_Vcepk MAX V(VCC,e2)\n.meas TRAN Q2_Pavg  AVG Ic(Q2)*V(VCC,e2)+Ib(Q2)*V(c1,e2) FROM 40m TO 50m\n.meas TRAN Q2_Ppk   MAX Ic(Q2)*V(VCC,e2)+Ib(Q2)*V(c1,e2)\n* ---- Q3 2N2222 (NPN): C=VCC, B=e2, E=e3 ----\n.meas TRAN Q3_Icpk  MAX abs(Ic(Q3))\n.meas TRAN Q3_Icq   AVG Ic(Q3) FROM 40m TO 50m\n.meas TRAN Q3_Vcepk MAX V(VCC,e3)\n.meas TRAN Q3_Pavg  AVG Ic(Q3)*V(VCC,e3)+Ib(Q3)*V(e2,e3) FROM 40m TO 50m\n.meas TRAN Q3_Ppk   MAX Ic(Q3)*V(VCC,e3)+Ib(Q3)*V(e2,e3)\n* ---- Output power (load is R6) ----\n.meas TRAN Pout AVG V(out)*I(R6) FROM 40m TO 50m
